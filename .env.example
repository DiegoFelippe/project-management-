# Copie para .env.local (ou rode "npm run env:local" com o Supabase local no ar).
# Na Vercel, crie estas mesmas variáveis com os dados do projeto do Supabase na nuvem
# (Project Settings > API Keys: use a chave publicável, nunca a secreta).
VITE_SUPABASE_URL=http://127.0.0.1:54521
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
